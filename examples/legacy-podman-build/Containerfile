# =============================================================================
# LEGACY EXAMPLE - a hand-maintained Containerfile built with "podman build".
# This is the pattern docs/podman-build-vs-ee-definition.md compares against
# the recommended ee_definitions/ approach. Kept as a realistic example;
# not recommended for new EEs.
#
# Originally generated by an older ansible-builder (3.0.x) and then edited by
# hand. The _build/ directory it expects is not stored here; compare.sh
# recreates it. Image references have been generalized.
# =============================================================================
ARG EE_BASE_IMAGE="registry.redhat.io/ansible-automation-platform-24/ee-minimal-rhel8:1.0.0-965"
ARG EE_BUILDER_IMAGE="registry.redhat.io/ansible-automation-platform-24/ansible-builder-rhel8:latest"
ARG PYCMD="/usr/bin/python3"
ARG PKGMGR_PRESERVE_CACHE=""
ARG ANSIBLE_GALAXY_CLI_COLLECTION_OPTS=""
ARG ANSIBLE_GALAXY_CLI_ROLE_OPTS=""

# Base build stage
FROM $EE_BASE_IMAGE as base
USER root
ARG EE_BASE_IMAGE
ARG EE_BUILDER_IMAGE
ARG PYCMD
ARG PKGMGR_PRESERVE_CACHE
ARG ANSIBLE_GALAXY_CLI_COLLECTION_OPTS
ARG ANSIBLE_GALAXY_CLI_ROLE_OPTS

RUN $PYCMD -m ensurepip
COPY _build/scripts/ /output/scripts/
COPY _build/scripts/entrypoint /opt/builder/bin/entrypoint

# Builder build stage
FROM base as builder
WORKDIR /build
ARG EE_BASE_IMAGE
ARG EE_BUILDER_IMAGE
ARG PYCMD
ARG PKGMGR_PRESERVE_CACHE
ARG ANSIBLE_GALAXY_CLI_COLLECTION_OPTS
ARG ANSIBLE_GALAXY_CLI_ROLE_OPTS

RUN rm -f /etc/yum.repos.d/ubi.repo
ADD pip.conf /etc/pip.conf
ADD ca-bundle.crt /etc/pki/ca-trust/source/anchors/company.crt
RUN update-ca-trust
RUN $PYCMD -m pip install --no-cache-dir bindep pyyaml requirements-parser
COPY _build/requirements.txt requirements.txt
ADD _build/bindep.txt bindep.txt
RUN $PYCMD /output/scripts/introspect.py introspect --sanitize --user-pip=requirements.txt --user-bindep=bindep.txt --write-bindep=/tmp/src/bindep.txt --write-pip=/tmp/src/requirements.txt
RUN /output/scripts/assemble

# Final build stage
FROM base as final
ARG EE_BASE_IMAGE
ARG EE_BUILDER_IMAGE
ARG PYCMD
ARG PKGMGR_PRESERVE_CACHE
ARG ANSIBLE_GALAXY_CLI_COLLECTION_OPTS
ARG ANSIBLE_GALAXY_CLI_ROLE_OPTS

COPY --from=builder /output/ /output/
COPY krb5.conf /etc/krb5.conf
RUN rm -f /etc/yum.repos.d/ubi.repo
ADD pip.conf /etc/pip.conf
ADD ca-bundle.crt /etc/pki/ca-trust/source/anchors/company.crt
RUN update-ca-trust
RUN /output/scripts/install-from-bindep && rm -rf /output/wheels
RUN rm -rf /output
LABEL ansible-execution-environment=true
